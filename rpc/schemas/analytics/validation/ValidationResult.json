{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "ValidationResult.json",
  "title": "ValidationResult",
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      }
    }
  },
  "required": [
    "issues"
  ],
  "additionalProperties": false,
  "$defs": {
    "ValidationIssue": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjectId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
